  "components": {
    "schemas": {
      "AdminResult": {
        "type": "object",
        "title": "AdminResult",
        "description": "Result of an admin action.",
        "required": [
          "id",
          "action",
          "status",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "`accepted` or `duplicate` (the same signed object was applied before)."
          },
          "result": {}
        }
      },
      "BatchResult": {
        "type": "object",
        "title": "BatchResult",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemResult"
            }
          }
        }
      },
      "ItemResult": {
        "type": "object",
        "title": "ItemResult",
        "description": "Result of one item in a batch.",
        "required": [
          "index",
          "status"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "format": "uint32"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "`accepted`, `duplicate` or `rejected`."
          },
          "problem": {
            "$ref": "#/components/schemas/Problem"
          }
        }
      },
      "KeyRegistered": {
        "type": "object",
        "title": "KeyRegistered",
        "required": [
          "key_id",
          "level",
          "status"
        ],
        "properties": {
          "key_id": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Problem": {
        "type": "object",
        "title": "Problem",
        "description": "RFC 9457 problem details (`application/problem+json`).",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "`https://eatsights.letsimpl.fyi/problems/<slug>`"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "uint16"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
