  "paths": {
    "/v1/places": {
      "get": {
        "tags": [
          "Data"
        ],
        "summary": "Search places by geohash cell, a quantised circle, city, category or name.",
        "parameters": [
          {
            "name": "cell",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "description": "Geohash cell (1-9 characters). Preferred: shared, cacheable URLs.",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "near",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "description": "`lat,lng`; quantised server-side (3 decimals).",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "radius",
            "schema": {
              "type": "number",
              "format": "double"
            },
            "in": "query",
            "description": "Metres, default 1000, max 2000; rounded up to 100 m.",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "city",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "category",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "q",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "description": "Name search (trigram, accent-insensitive).",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "limit",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "The document. Cacheable; weak `ETag` from the change sequence.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {}
              }
            },
            "headers": {
              "ETAG": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "CACHE-CONTROL": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "VARY": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "CONTENT-ENCODING": {
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged since the given `If-None-Match`.",
            "headers": {
              "ETAG": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              },
              "CACHE-CONTROL": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "301": {
            "description": "The record was merged; follow `Location` to the survivor.",
            "headers": {
              "LOCATION": {
                "required": true,
